{
  "expo": {
    "name": "Downpipe",
    "slug": "downpipe",
    "scheme": "downpipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131313",
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "O Downpipe usa a camera na portaria do role, para ler o QR dos ingressos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Downpipe usa sua localizacao para marcar o ponto exato do encontro no mapa."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-1284.png",
          "resizeMode": "contain",
          "backgroundColor": "#131313",
          "imageWidth": 200
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.downpipe.app",
      "icon": "./assets/icon-1024.png"
    },
    "android": {
      "package": "com.downpipe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-maskable-1024.png",
        "backgroundColor": "#131313"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "icon": "./assets/icon-1024.png",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
